# ------------------------------------------------------------
# 4. Frontend / Node.js
# ------------------------------------------------------------

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock
.npm
.yarn-integrity
.node_repl_history

# Build output
/dist/
/build/
/out/
/.next/
/.nuxt/
/.output/
/.svelte-kit/
/.turbo/
/.parcel-cache/
/.cache/
/.vite/
/.storybook-out/

# Type declaration artifacts
*.tsbuildinfo
tsconfig.tsbuildinfo

# Local environment variables (keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Testing & coverage
coverage/
.nyc_output/
jest-coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
cypress/videos/
cypress/screenshots/
cypress/downloads/
jest_html_reporters/
htmlcov/

# Monorepo / tooling caches
.pnpm-debug.log*
.turbo/
.eslintcache
.stylelintcache

# Generated source maps
*.map
!**/*.min.css.map   # keep source maps if needed, remove this line otherwise

# ------------------------------------------------------------
# 5. Backend / Server / Containers
# ------------------------------------------------------------

# Java Spring
*.log
application-local.yml
application-local.properties
application-local.yaml

# Temp files & backups
*.bak
*.backup
*.orig
*.rej
*.swp
*.swo

# Archives
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z
*.gz

# Uploads / user data
uploads/
files/
media/
user_uploads/
static/uploads/

# Databases
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# ------------------------------------------------------------
# 6. Configuration & Sensitive Info (keep these!)
# ------------------------------------------------------------

# Certificates / keys (NEVER commit)
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
*.keystore
*.p8
*.asc
*.gpg
*.pgp
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
secrets.json
credentials.json
service-account*.json

# Key scanning fallback
**/*.pem
**/*.key
!example.key

# Local override config
config.local.*
settings.local.*
*.local.json
*.local.yml
*.local.yaml
*.local.js
*.local.ts

# ------------------------------------------------------------
# 7. Version Control / Miscellaneous
# ------------------------------------------------------------

# Git
*.orig
*.bak
*.swp
*.tmp
.git/
gitk*
*.patch
*.diff

# SVN / HG / CVS
.svn/
.hg/
.hgignore
.hgtags
CVS/

# Log directories
*.log
logs/

# API docs generation
/docs/api/
/apidoc/
/site/
/sphinx-build/

# Local task scripts
/taskfile.local.yml
Makefile.local

# Large files / datasets (outside of Git LFS)
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle
*.bin
*.dat
*.parquet
*.feather

# ------------------------------------------------------------
# 8. Whitelist (place at the end)
# ------------------------------------------------------------

# Allow committing example files
!*.example
!*.sample
!.env.example
!docker-compose.override.example.yml
!mac/en/README.md
!**/LICENSE
!**/CHANGELOG.md
.venv/
frontend/dist/
