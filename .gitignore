# ============================================================
# Universal .gitignore — suitable for frontend & backend projects
# Usage: remove sections irrelevant to your project, or keep all
# ============================================================

# ------------------------------------------------------------
# 1. Operating Systems
# ------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.volumeinfo.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump
[Dd]esktop.ini
*.cab
*.msi
*.msix
*.msm
*.msp
*.sys
*.tmp
*.temp

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

